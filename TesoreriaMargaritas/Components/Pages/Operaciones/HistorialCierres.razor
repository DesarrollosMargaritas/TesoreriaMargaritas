@page "/operaciones/historial-cierres"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TesoreriaMargaritas.Models
@using TesoreriaMargaritas.Services
@using System.Text.Json
@using System.Security.Claims
@attribute [Authorize(Roles = "Tesorero, Administrador, Contador")]
@rendermode RenderMode.InteractiveServer
@inject TesoreriaService TesoreriaService
@inject AuthenticationStateProvider AuthStateProvider
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>Historial de Cierres</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-clock-history text-secondary"></i> Historial de Cierres</h2>
        <a href="@rutaVolver" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    @if (listaCierres == null)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p>Cargando historial...</p>
        </div>
    }
    else if (!listaCierres.Any())
    {
        <div class="alert alert-info">No se encontraron cierres registrados.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Fecha</th>
                            <th>Responsable</th>
                            <th>Efectivo Físico</th>
                            <th>Descuadre Efec.</th>
                            <th>Descuadre Nequi</th>
                            <th>Descuadre Davi</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in listaCierres)
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark border">@c.Id</span></td>
                                <td>
                                    <div class="fw-bold">@c.FechaArqueo.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted">@c.FechaHora.ToString("hh:mm tt")</small>
                                </td>
                                <td>@c.UsuarioId</td>
                                <td class="fw-bold">@c.FisicoEfectivo.ToString("C0")</td>

                                <!-- Descuadre Efectivo -->
                                <td>
                                    @RenderBadge(c.DescuadreEfectivo)
                                </td>

                                <!-- Descuadre Nequi -->
                                <td>
                                    @RenderBadge(c.DescuadreNequi)
                                </td>

                                <!-- Descuadre Daviplata -->
                                <td>
                                    @RenderBadge(c.DescuadreDaviplata)
                                </td>

                                <td>
                                    <button class="btn btn-sm btn-primary" @onclick="() => VerDetalle(c)">
                                        <i class="bi bi-eye"></i> Detalle
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- MODAL DE DETALLE MEJORADO -->
@if (arqueoSeleccionado != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-file-text"></i> Detalle Cierre #@arqueoSeleccionado.Id
                        <small class="ms-2 opacity-75">(@arqueoSeleccionado.FechaArqueo.ToShortDateString())</small>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body bg-light">

                    <div class="row g-3">

                        <!-- 1. BLOQUE EFECTIVO -->
                        <div class="col-md-4">
                            <div class="card h-100 border-primary shadow-sm">
                                <div class="card-header bg-primary text-white">
                                    <h6 class="mb-0">💵 Efectivo</h6>
                                </div>
                                <div class="card-body">
                                    <ul class="list-group list-group-flush small">
                                        <li class="list-group-item d-flex justify-content-between">
                                            <span>Saldo Inicial:</span>
                                            <span>@arqueoSeleccionado.SaldoInicialEfectivo.ToString("C0")</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between text-success">
                                            <span>(+) Entradas:</span>
                                            <span>@arqueoSeleccionado.SistEntradasEfectivo.ToString("C0")</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between text-danger">
                                            <span>(-) Salidas:</span>
                                            <span>@arqueoSeleccionado.SistSalidasEfectivo.ToString("C0")</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between fw-bold bg-light">
                                            <span>(=) Sistema:</span>
                                            <span>@arqueoSeleccionado.SistTotalEfectivo.ToString("C0")</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between fw-bold text-primary mt-2 border-top">
                                            <span>Físico Contado:</span>
                                            <span>@arqueoSeleccionado.FisicoEfectivo.ToString("C0")</span>
                                        </li>
                                    </ul>

                                    <div class="mt-3 text-center">
                                        <small class="text-muted">Diferencia Efectivo</small>
                                        <h4 class="@GetColor(arqueoSeleccionado.DescuadreEfectivo)">
                                            @arqueoSeleccionado.DescuadreEfectivo.ToString("C0")
                                        </h4>
                                    </div>

                                    <!-- Detalle Billetes -->
                                    <details class="mt-2">
                                        <summary class="small text-muted cursor-pointer">Ver Billetes</summary>
                                        <ul class="list-group list-group-flush small mt-1">
                                            @foreach (var billete in arqueoSeleccionado.DetalleConteo)
                                            {
                                                if (billete.Value > 0)
                                                {
                                                    <li class="list-group-item d-flex justify-content-between py-0 text-muted">
                                                        <span>$@decimal.Parse(billete.Key).ToString("N0") x @billete.Value</span>
                                                        <span>@((decimal.Parse(billete.Key) * billete.Value).ToString("C0"))</span>
                                                    </li>
                                                }
                                            }
                                        </ul>
                                    </details>
                                </div>
                            </div>
                        </div>

                        <!-- 2. BLOQUE NEQUI -->
                        <div class="col-md-4">
                            <div class="card h-100 border-dark shadow-sm">
                                <div class="card-header bg-dark text-white">
                                    <h6 class="mb-0">📱 Nequi</h6>
                                </div>
                                <div class="card-body">
                                    <ul class="list-group list-group-flush small">
                                        <li class="list-group-item d-flex justify-content-between">
                                            <span>Saldo Inicial:</span>
                                            <span>@arqueoSeleccionado.SaldoInicialNequi.ToString("C0")</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between text-success">
                                            <span>(+) Entradas:</span>
                                            <span>@arqueoSeleccionado.SistEntradasNequi.ToString("C0")</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between text-danger">
                                            <span>(-) Salidas:</span>
                                            <span>@arqueoSeleccionado.SistSalidasNequi.ToString("C0")</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between fw-bold bg-light">
                                            <span>(=) Sistema Neto:</span>
                                            <span>@arqueoSeleccionado.SistTotalNequi.ToString("C0")</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between fw-bold text-dark mt-2 border-top">
                                            <span>Reportado App:</span>
                                            <span>@arqueoSeleccionado.ReportadoNequi.ToString("C0")</span>
                                        </li>
                                    </ul>
                                    <div class="mt-3 text-center">
                                        <small class="text-muted">Diferencia Nequi</small>
                                        <h4 class="@GetColor(arqueoSeleccionado.DescuadreNequi)">
                                            @arqueoSeleccionado.DescuadreNequi.ToString("C0")
                                        </h4>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 3. BLOQUE DAVIPLATA -->
                        <div class="col-md-4">
                            <div class="card h-100 border-danger shadow-sm">
                                <div class="card-header bg-danger text-white">
                                    <h6 class="mb-0">🔴 Daviplata</h6>
                                </div>
                                <div class="card-body">
                                    <ul class="list-group list-group-flush small">
                                        <li class="list-group-item d-flex justify-content-between">
                                            <span>Saldo Inicial:</span>
                                            <span>@arqueoSeleccionado.SaldoInicialDaviplata.ToString("C0")</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between text-success">
                                            <span>(+) Entradas:</span>
                                            <span>@arqueoSeleccionado.SistEntradasDaviplata.ToString("C0")</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between text-danger">
                                            <span>(-) Salidas:</span>
                                            <span>@arqueoSeleccionado.SistSalidasDaviplata.ToString("C0")</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between fw-bold bg-light">
                                            <span>(=) Sistema Neto:</span>
                                            <span>@arqueoSeleccionado.SistTotalDaviplata.ToString("C0")</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between fw-bold text-danger mt-2 border-top">
                                            <span>Reportado App:</span>
                                            <span>@arqueoSeleccionado.ReportadoDaviplata.ToString("C0")</span>
                                        </li>
                                    </ul>
                                    <div class="mt-3 text-center">
                                        <small class="text-muted">Diferencia Daviplata</small>
                                        <h4 class="@GetColor(arqueoSeleccionado.DescuadreDaviplata)">
                                            @arqueoSeleccionado.DescuadreDaviplata.ToString("C0")
                                        </h4>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div> <!-- End Row -->
                    @if (!string.IsNullOrEmpty(arqueoSeleccionado.Observaciones))
                    {
                        <div class="alert alert-warning mt-3 mb-0 d-flex align-items-center">
                            <i class="bi bi-info-circle-fill me-2 fs-4"></i>
                            <div>
                                <strong>Observaciones del Cierre:</strong><br />
                                @arqueoSeleccionado.Observaciones
                            </div>
                        </div>
                    }

                </div>
                <div class="modal-footer bg-white">
                    <button class="btn btn-success" @onclick="() => DescargarExcel(arqueoSeleccionado.Id)">
                        <i class="bi bi-file-earmark-excel"></i> Descargar Excel
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

<script>
    window.downloadFileFromStream = async (fileName, contentStreamReference) => {
        const arrayBuffer = await contentStreamReference.arrayBuffer();
        const blob = new Blob([arrayBuffer]);
        const url = URL.createObjectURL(blob);
        const anchorElement = document.createElement('a');
        anchorElement.href = url;
        anchorElement.download = fileName ?? '';
        anchorElement.click();
        anchorElement.remove();
        URL.revokeObjectURL(url);
    }
</script>

@code {
    private List<Arqueo>? listaCierres;
    private Arqueo? arqueoSeleccionado;
    private string rutaVolver = "/tesorero";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.IsInRole("Contador")) rutaVolver = "/contador";
        else if (user.IsInRole("Tesorero")) rutaVolver = "/tesorero";
        else rutaVolver = "/";

        listaCierres = await TesoreriaService.ObtenerHistorialCierresAsync();
    }

    private void VerDetalle(Arqueo arqueo)
    {
        arqueoSeleccionado = arqueo;
    }

    private void CerrarModal()
    {
        arqueoSeleccionado = null;
    }

    private string GetColor(decimal val) => val == 0 ? "text-success" : (val < 0 ? "text-danger" : "text-warning");

    // Helper para renderizar badges en la tabla
    private RenderFragment RenderBadge(decimal valor) => builder =>
    {
        if (valor == 0)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "badge bg-success-subtle text-success border border-success");
            builder.AddContent(2, "OK");
            builder.CloseElement();
        }
        else if (valor < 0)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "badge bg-danger text-white");
            builder.AddContent(2, valor.ToString("C0"));
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "badge bg-warning text-dark");
            builder.AddContent(2, "+" + valor.ToString("C0"));
            builder.CloseElement();
        }
    };

    private async Task DescargarExcel(int id)
    {
        var bytes = await TesoreriaService.GenerarReporteExcelCierreAsync(id);
        var fileName = $"Cierre_{id}_{DateTime.Now:yyyyMMdd}.xlsx";

        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);

        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }
}
@page "/operaciones/entradas"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TesoreriaMargaritas.Models
@using TesoreriaMargaritas.Services
@using System.Security.Claims
@attribute [Authorize(Roles = "Tesorero, Administrador")]
@rendermode RenderMode.InteractiveServer
@inject TesoreriaService TesoreriaService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Registro de Entradas</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-graph-up-arrow text-success"></i> Entradas de Dinero</h2>
        <a href="/tesorero" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <div class="row">
        <!-- Formulario -->
        <div class="col-md-4">
            <div class="card shadow-sm border-success mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Nueva Entrada</h5>
                </div>
                <div class="card-body">
                    @if (mostrarExito)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="bi bi-check-circle"></i> Guardado.
                            <button type="button" class="btn-close" @onclick="() => mostrarExito = false"></button>
                        </div>
                    }

                    <EditForm Model="@nuevaEntrada" OnValidSubmit="GuardarEntrada">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Concepto</label>
                            <InputSelect @bind-Value="nuevaEntrada.Concepto" class="form-select">
                                <option value="">-- Seleccione --</option>
                                @foreach (var c in listaConceptos)
                                {
                                    <option value="@c">@c</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => nuevaEntrada.Concepto)" />
                        </div>

                        <!-- NUEVO SELECTOR FORMA DE PAGO -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Forma de Pago</label>
                            <InputSelect @bind-Value="nuevaEntrada.FormaPago" class="form-select border-success">
                                <option value="Efectivo">Efectivo 💵</option>
                                <option value="Nequi">Nequi 📱</option>
                                <option value="Daviplata">Daviplata 🔴</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => nuevaEntrada.FormaPago)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Monto ($)</label>
                            <InputText @bind-Value="MontoConFormato" class="form-control fw-bold text-end text-success fs-5" />
                            <ValidationMessage For="@(() => nuevaEntrada.Monto)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Observaciones</label>
                            <InputTextArea @bind-Value="nuevaEntrada.Observaciones" class="form-control" rows="2" />
                        </div>

                        <button type="submit" class="btn btn-success w-100 btn-lg">Registrar</button>
                    </EditForm>
                </div>
            </div>
        </div>

        <!-- Tabla -->
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Hora</th>
                                <th>Concepto</th>
                                <th>Medio</th>
                                <th class="text-end">Monto</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listaEntradas != null)
                            {
                                @foreach (var item in listaEntradas)
                                {
                                    <tr>
                                        <td>@item.Fecha.ToString("HH:mm")</td>
                                        <td>@item.Concepto</td>
                                        <td>
                                            @if (item.FormaPago == "Efectivo")
                                            {
                                                <span class="badge bg-success">Efectivo</span>
                                            }
                                            else if (item.FormaPago == "Nequi")
                                            {

                                                <span class="badge bg-dark">Nequi</span>
                                            }
                                            else
                                            {

                                                <span class="badge bg-danger">Daviplata</span>
                                            }
                                        </td>
                                        <td class="text-end fw-bold">@item.Monto.ToString("C0")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm] private Entrada nuevaEntrada { get; set; } = new Entrada();
    private List<Entrada>? listaEntradas;
    private bool mostrarExito;
    private string usuarioIdLogueado = "";

    private string MontoConFormato
    {
        get => nuevaEntrada.Monto == 0 ? "" : nuevaEntrada.Monto.ToString("N0");
        set { if (decimal.TryParse(new string(value.Where(char.IsDigit).ToArray()), out decimal r)) nuevaEntrada.Monto = r; }
    }

    private List<string> listaConceptos = new List<string> { "Caja 01", "Caja 02", "Caja 03", "PV PERU", "PV ROTONDA", "SOCIOS", "TO-GO" };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        usuarioIdLogueado = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
        nuevaEntrada.UsuarioId = usuarioIdLogueado;
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        listaEntradas = await TesoreriaService.ObtenerEntradasAsync();
    }

    private async Task GuardarEntrada()
    {
        if (string.IsNullOrEmpty(usuarioIdLogueado)) return;
        nuevaEntrada.UsuarioId = usuarioIdLogueado;
        nuevaEntrada.Fecha = DateTime.Now;
        await TesoreriaService.RegistrarEntradaAsync(nuevaEntrada);
        mostrarExito = true;
        nuevaEntrada = new Entrada { UsuarioId = usuarioIdLogueado, FormaPago = "Efectivo" }; // Reset
        await CargarDatos();
    }
}
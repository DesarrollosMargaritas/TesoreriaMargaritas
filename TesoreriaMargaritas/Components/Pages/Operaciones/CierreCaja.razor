@page "/operaciones/cierre-caja"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TesoreriaMargaritas.Models
@using TesoreriaMargaritas.Services
@using System.Security.Claims
@using System.Text.Json
@attribute [Authorize(Roles = "Tesorero, Administrador")]
@rendermode RenderMode.InteractiveServer
@inject TesoreriaService TesoreriaService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Cierre de Caja Multimedio</PageTitle>

<div class="container mt-4 pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-safe2 text-primary"></i> Cierre de Caja</h2>
        <a href="/tesorero" class="btn btn-outline-secondary">Cancelar</a>
    </div>

    @if (cierreExitoso)
    {
        <div class="alert alert-success text-center py-5">
            <h1 class="display-4"><i class="bi bi-check-circle-fill"></i></h1>
            <h3>¡Cierre Guardado!</h3>
            <p>Se han conciliado Efectivo, Nequi y Daviplata.</p>
            <a href="/tesorero" class="btn btn-primary mt-3">Volver al Inicio</a>
        </div>
    }
    else
    {
        <!-- 1. ARQUEO DE EFECTIVO -->
        <div class="card shadow-sm border-primary mb-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between">
                <h5 class="mb-0">1. Arqueo de Efectivo 💵</h5>
                <span class="badge bg-white text-primary">Saldo Inicial: @arqueo.SaldoInicialEfectivo.ToString("C0")</span>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Billetes -->
                    <div class="col-md-7 border-end">
                        <h6 class="text-muted mb-3">Conteo de Billetes</h6>
                        <div class="row g-2">
                            @foreach (var denom in denominaciones)
                            {
                                <div class="col-4 col-sm-3">
                                    <label class="small fw-bold">@denom.Key.ToString("N0")</label>
                                    <input type="number" min="0" class="form-control form-control-sm text-end bg-light"
                                           value="@(conteo[denom.Key])"
                                           @onchange="@(e => ActualizarConteo(denom.Key, e.Value))" />
                                </div>
                            }
                        </div>
                        <div class="mt-3 p-2 bg-light rounded d-flex justify-content-between fw-bold text-primary">
                            <span>TOTAL FÍSICO:</span>
                            <span>@TotalFisicoEfectivo.ToString("C0")</span>
                        </div>
                    </div>
                    <!-- Resumen Sistema -->
                    <div class="col-md-5 ps-md-4">
                        <h6 class="text-muted">Sistema Efectivo</h6>
                        <ul class="list-group list-group-flush small">
                            <li class="list-group-item d-flex justify-content-between"><span>(+) Entradas:</span> <span>@arqueo.SistEntradasEfectivo.ToString("C0")</span></li>
                            <li class="list-group-item d-flex justify-content-between"><span>(-) Salidas:</span> <span>@arqueo.SistSalidasEfectivo.ToString("C0")</span></li>
                            <li class="list-group-item d-flex justify-content-between fw-bold"><span>(=) Debería Haber:</span> <span>@arqueo.SistTotalEfectivo.ToString("C0")</span></li>
                        </ul>
                        <div class="mt-3 text-center">
                            <small>Diferencia Efectivo</small>
                            <h3 class="@GetColor(DescuadreEfectivo)">@DescuadreEfectivo.ToString("C0")</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. CRUCE NEQUI -->
        <div class="card shadow-sm border-dark mb-4">
            <div class="card-header bg-dark text-white d-flex justify-content-between">
                <h5 class="mb-0">2. Cruce Nequi 📱</h5>
                <span class="badge bg-white text-dark">Inicial: @arqueo.SaldoInicialNequi.ToString("C0")</span>
            </div>
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">¿Cuánto reporta la App/Movimientos del día?</label>
                        <InputNumber @bind-Value="arqueo.ReportadoNequi" class="form-control form-control-lg fw-bold" />
                        <small class="text-muted">Ingrese el saldo final de la App Nequi.</small>
                    </div>
                    <div class="col-md-6">
                        <ul class="list-group small">
                            <li class="list-group-item d-flex justify-content-between"><span>Entradas Nequi:</span> <span class="text-success">@arqueo.SistEntradasNequi.ToString("C0")</span></li>
                            <li class="list-group-item d-flex justify-content-between"><span>Salidas Nequi:</span> <span class="text-danger">@arqueo.SistSalidasNequi.ToString("C0")</span></li>
                            <li class="list-group-item d-flex justify-content-between fw-bold bg-light"><span>Debería Haber:</span> <span>@arqueo.SistTotalNequi.ToString("C0")</span></li>
                        </ul>
                        <div class="text-end mt-2">
                            <strong>Dif: </strong> <span class="@GetColor(arqueo.ReportadoNequi - arqueo.SistTotalNequi)">@((arqueo.ReportadoNequi - arqueo.SistTotalNequi).ToString("C0"))</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. CRUCE DAVIPLATA -->
        <div class="card shadow-sm border-danger mb-4">
            <div class="card-header bg-danger text-white d-flex justify-content-between">
                <h5 class="mb-0">3. Cruce Daviplata 🔴</h5>
                <span class="badge bg-white text-danger">Inicial: @arqueo.SaldoInicialDaviplata.ToString("C0")</span>
            </div>
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">¿Cuánto reporta Daviplata?</label>
                        <InputNumber @bind-Value="arqueo.ReportadoDaviplata" class="form-control form-control-lg fw-bold text-danger" />
                    </div>
                    <div class="col-md-6">
                        <ul class="list-group small">
                            <li class="list-group-item d-flex justify-content-between"><span>Entradas Davi:</span> <span class="text-success">@arqueo.SistEntradasDaviplata.ToString("C0")</span></li>
                            <li class="list-group-item d-flex justify-content-between"><span>Salidas Davi:</span> <span class="text-danger">@arqueo.SistSalidasDaviplata.ToString("C0")</span></li>
                            <li class="list-group-item d-flex justify-content-between fw-bold bg-light"><span>Debería Haber:</span> <span>@arqueo.SistTotalDaviplata.ToString("C0")</span></li>
                        </ul>
                        <div class="text-end mt-2">
                            <strong>Dif: </strong> <span class="@GetColor(arqueo.ReportadoDaviplata - arqueo.SistTotalDaviplata)">@((arqueo.ReportadoDaviplata - arqueo.SistTotalDaviplata).ToString("C0"))</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-grid gap-2 mb-5">
            <button class="btn btn-success btn-lg py-3" @onclick="CerrarCaja" disabled="@procesando">
                @if (procesando)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                else
                {

                    <i class="bi bi-lock-fill"></i>
                }
                CONFIRMAR CIERRE DEFINITIVO
            </button>
        </div>
    }
</div>

@code {
    private Arqueo arqueo = new Arqueo();
    private Dictionary<int, int> denominaciones = new() { { 100000, 0 }, { 50000, 0 }, { 20000, 0 }, { 10000, 0 }, { 5000, 0 }, { 2000, 0 }, { 1000, 0 }, { 500, 0 }, { 200, 0 }, { 100, 0 }, { 50, 0 } };
    private Dictionary<int, int> conteo = new();

    private decimal TotalFisicoEfectivo => conteo.Sum(x => x.Key * x.Value);
    private decimal DescuadreEfectivo => TotalFisicoEfectivo - arqueo.SistTotalEfectivo;

    private bool procesando = false;
    private bool cierreExitoso = false;
    private string usuarioId = "";

    protected override async Task OnInitializedAsync()
    {
        foreach (var kvp in denominaciones) conteo.Add(kvp.Key, 0);
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        usuarioId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";

        arqueo = await TesoreriaService.SimularCierreActualAsync();
    }

    private void ActualizarConteo(int denom, object? valor)
    {
        if (int.TryParse(valor?.ToString(), out int val) && val >= 0) conteo[denom] = val;
        else conteo[denom] = 0;
    }

    private string GetColor(decimal val) => val == 0 ? "text-success" : (val < 0 ? "text-danger" : "text-warning");

    private async Task CerrarCaja()
    {
        procesando = true;
        arqueo.UsuarioId = usuarioId;
        arqueo.FechaHora = DateTime.Now;
        arqueo.FechaArqueo = DateTime.Today;

        // Asignar valores físicos
        arqueo.ConteoBilletesJson = JsonSerializer.Serialize(conteo);
        arqueo.FisicoEfectivo = TotalFisicoEfectivo;
        // arqueo.ReportadoNequi y ReportadoDaviplata ya están bindeados

        try
        {
            await TesoreriaService.GuardarCierreCajaAsync(arqueo);
            cierreExitoso = true;
        }
        catch (Exception ex)
        {
            // Manejar error
            Console.WriteLine(ex.Message);
        }
        finally { procesando = false; }
    }
}
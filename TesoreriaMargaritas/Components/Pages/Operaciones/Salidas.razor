@page "/operaciones/salidas"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TesoreriaMargaritas.Models
@using TesoreriaMargaritas.Services
@using System.Security.Claims
@attribute [Authorize(Roles = "Tesorero, Administrador")]
@rendermode RenderMode.InteractiveServer
@inject TesoreriaService TesoreriaService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Registro de Salidas</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-cart-x text-danger"></i> Gastos y Salidas</h2>
        <a href="/tesorero" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
    </div>

    <div class="row">
        <div class="col-lg-5">
            <div class="card shadow-sm border-danger mb-4">
                <div class="card-header bg-danger text-white"><h5 class="mb-0">Nuevo Egreso</h5></div>
                <div class="card-body">
                    @if (mostrarExito)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            Gasto guardado. <button type="button" class="btn-close" @onclick="() => mostrarExito = false"></button>
                        </div>
                    }

                    <EditForm Model="@nuevoGasto" OnValidSubmit="GuardarGasto">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Concepto</label>
                            <InputSelect Value="@nuevoGasto.Concepto" ValueExpression="@(() => nuevoGasto.Concepto)" ValueChanged="@((string s) => CambioConcepto(s))" class="form-select">
                                <option value="">-- Seleccione --</option>
                                <option value="Gasto">Gasto (Interno)</option>
                                <option value="Facturas">Facturas</option>
                                <option value="Simplificados">Simplificados</option>
                                <option value="Nominas">Nóminas</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => nuevoGasto.Concepto)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Beneficiario</label>
                            <InputText @bind-Value="nuevoGasto.Beneficiario" class="form-control text-uppercase" />
                            <ValidationMessage For="@(() => nuevoGasto.Beneficiario)" />
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label">Prefijo</label>
                                <InputText @bind-Value="nuevoGasto.Prefijo" class="form-control" disabled="@esPrefijoFijo" />
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label">Consecutivo</label>
                                <InputNumber @bind-Value="nuevoGasto.Consecutivo" class="form-control" disabled="@(!esConsecutivoManual)" />
                            </div>
                        </div>

                        <!-- NUEVO SELECTOR FORMA PAGO -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Medio de Pago</label>
                            <InputSelect @bind-Value="nuevoGasto.FormaPago" class="form-select border-danger">
                                <option value="Efectivo">Efectivo 💵</option>
                                <option value="Nequi">Nequi 📱</option>
                                <option value="Daviplata">Daviplata 🔴</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => nuevoGasto.FormaPago)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Monto ($)</label>
                            <InputText @bind-Value="MontoConFormato" class="form-control fw-bold text-end text-danger fs-5" />
                            <ValidationMessage For="@(() => nuevoGasto.Monto)" />
                        </div>

                        <button type="submit" class="btn btn-danger w-100 btn-lg">Registrar Salida</button>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-hover mb-0 small">
                        <thead class="table-light">
                            <tr><th>Fecha</th><th>Ref</th><th>Beneficiario</th><th>Medio</th><th class="text-end">Monto</th></tr>
                        </thead>
                        <tbody>
                            @if (listaGastos != null)
                            {
                                @foreach (var g in listaGastos)
                                {
                                    <tr>
                                        <td>@g.Fecha.ToString("dd/MM HH:mm")</td>
                                        <td>@g.Prefijo-@g.Consecutivo</td>
                                        <td class="text-truncate" style="max-width: 120px;">@g.Beneficiario</td>
                                        <td>@g.FormaPago</td>
                                        <td class="text-end fw-bold text-danger">@g.Monto.ToString("C0")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm] private Gasto nuevoGasto { get; set; } = new Gasto();
    private List<Gasto>? listaGastos;
    private bool esPrefijoFijo = true;
    private bool esConsecutivoManual = false;
    private bool mostrarExito = false;
    private string usuarioIdLogueado = "";

    private string MontoConFormato
    {
        get => nuevoGasto.Monto == 0 ? "" : nuevoGasto.Monto.ToString("N0");
        set { if (decimal.TryParse(new string(value.Where(char.IsDigit).ToArray()), out decimal r)) nuevoGasto.Monto = r; }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        usuarioIdLogueado = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
        nuevoGasto.UsuarioId = usuarioIdLogueado;
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        listaGastos = await TesoreriaService.ObtenerGastosAsync();
    }

    private void CambioConcepto(string concepto)
    {
        nuevoGasto.Concepto = concepto;
        // Lógica de prefijos igual a la anterior
        if (concepto == "Gasto") { nuevoGasto.Prefijo = "GAP"; esPrefijoFijo = true; esConsecutivoManual = false; }
        else if (concepto == "Facturas") { nuevoGasto.Prefijo = ""; esPrefijoFijo = false; esConsecutivoManual = true; }
        else if (concepto == "Simplificados") { nuevoGasto.Prefijo = "SMP"; esPrefijoFijo = true; esConsecutivoManual = false; }
        else if (concepto == "Nominas") { nuevoGasto.Prefijo = "NMP"; esPrefijoFijo = true; esConsecutivoManual = false; }
    }

    private async Task GuardarGasto()
    {
        if (string.IsNullOrEmpty(usuarioIdLogueado)) return;
        nuevoGasto.Beneficiario = nuevoGasto.Beneficiario.ToUpper();
        if (!string.IsNullOrEmpty(nuevoGasto.Prefijo)) nuevoGasto.Prefijo = nuevoGasto.Prefijo.ToUpper();

        nuevoGasto.UsuarioId = usuarioIdLogueado;
        nuevoGasto.Fecha = DateTime.Now;

        await TesoreriaService.RegistrarGastoAsync(nuevoGasto);
        mostrarExito = true;
        nuevoGasto = new Gasto { UsuarioId = usuarioIdLogueado, FormaPago = "Efectivo" };
        CambioConcepto("");
        await CargarDatos();
    }
}